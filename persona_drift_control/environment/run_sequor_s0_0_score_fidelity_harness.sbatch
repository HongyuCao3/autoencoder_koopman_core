#!/bin/bash
#SBATCH --job-name pdc-sequor-s00-score-fid
#SBATCH --cpus-per-task 8
#SBATCH --mem 96G
#SBATCH --time 01:30:00
#SBATCH --requeue
#SBATCH --gpus a100:1
#SBATCH --output /home/hcao2/autoencoder_koopman_core/persona_drift_control/environment/slurm_logs/sequor-s00-score-fid-%j.out

# READOUTS for the fidelity-harness S0-0 arm (instrument).
# The arm itself was generated by job 15761810 and is on disk: 1404 rows, 684
# pairs, 3 seeds, constraints in a system message, model-default sampling. That
# job died writing its summary; the summary was rebuilt from the rows
# (scripts/rebuild_sequor_arm_report.py), and nothing needs regenerating.
#
# GENERATION IS NOT REPEATED HERE, deliberately: this sbatch has no phase 1, so
# it cannot overwrite the arm. The arm runner's own guard would refuse anyway
# (job 15762950 hit exactly that, correctly).
#
# ALL 1404 rows are judged, including tuple_294_1, whose per-item response-cap
# share is 21.4% and which the user ruled 2026-09-09 to EXCLUDE at gate time
# (`--exclude-item`, recorded in the gate report). The exclusion belongs to the
# analysis, not to the scoring: judging it costs 8% more calls and keeps the
# ruling reversible without another GPU job.
#
# RUNTIME ESTIMATE 25-35 min. Measured: 0.10 s/judge-call for the 14B on this
# task (job 15759226), 4212 calls => ~7 min plus ~4 min to load; the 4B at cap
# 1024 ran 0.09 s/call at cap 512 (job 15739196), so budget ~0.15 => ~11 min
# plus ~3 min. --time 01:30:00 is >= 2.5x.
#
# Two phases, one job, sequential: two models will not co-reside on a 40GB card.

set -euo pipefail

module load anaconda3
source activate /scratch/hcao2/envs/sequor_vllm

export HF_HOME=/scratch/hcao2/hf_cache
export VLLM_WORKER_MULTIPROC_METHOD=spawn
export VLLM_USE_FLASHINFER_SAMPLER=0

cd /home/hcao2/autoencoder_koopman_core/persona_drift_control

nvidia-smi -L || true

ARM=outputs/sequor_s0_0_branch_arm_fidelity_harness

echo "=== phase 1/2: reporting-judge readout (the gates read this one) ==="
python scripts/score_sequor_trajectories.py \
  --arm-dir "$ARM" \
  --judge-model Qwen/Qwen3-14B \
  --judge-kind independent \
  --max-new-tokens 512 \
  --out-path "$ARM/readout_independent_qwen3_14b.json"

echo "=== phase 2/2: in-loop self-judge readout (selection signal, never reported) ==="
python scripts/score_sequor_trajectories.py \
  --arm-dir "$ARM" \
  --judge-model Qwen/Qwen3-4B-Instruct-2507 \
  --judge-kind self \
  --max-new-tokens 1024 \
  --out-path "$ARM/readout_self_qwen3_4b_instruct_2507.json"
